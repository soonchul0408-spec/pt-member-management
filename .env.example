# 서버 API를 연결할 때 사용할 설정입니다. 현재 프로토타입은 샘플 데이터와 localStorage를 사용합니다.
VITE_API_ENABLED=false
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase를 연결하면 인증 모드가 자동으로 켜집니다. 명시적으로 보호 모드를 켤 때 true로 설정합니다.
VITE_REQUIRE_AUTH=true
# 회원 로그인 화면에서는 이메일을 숨기고 이 계정으로 비밀번호 인증을 수행합니다.
VITE_MEMBER_LOGIN_EMAIL=
VITE_LOCAL_EDITOR_MODE=false
