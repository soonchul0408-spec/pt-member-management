# 개발 기본값은 localStorage 데모입니다. Vercel 운영 빌드는 API 저장을 사용합니다.
VITE_SUPABASE_URL=
# 기존 Supabase 프로젝트에서 anon 키를 쓰는 경우의 호환 이름입니다.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 비워두면 운영 빌드에서 API, 로컬 개발에서 localStorage를 사용합니다.
VITE_PT_DATA_MODE=
VITE_PT_API_BASE_URL=/api/v1
# Supabase를 연결하면 인증 모드가 자동으로 켜집니다. 개발 localStorage 데모는 false로 둘 수 있습니다.
# 운영 빌드는 이 값과 관계없이 인증을 요구합니다.
VITE_REQUIRE_AUTH=false
# 회원 로그인 화면에서는 이메일을 숨기고 이 계정으로 비밀번호 인증을 수행합니다.
VITE_MEMBER_LOGIN_EMAIL=
VITE_LOCAL_EDITOR_MODE=false

# 아래 값은 Vercel Serverless Function 전용입니다. VITE_ 접두사를 붙이지 말고
# 클라이언트 변수로 공개하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
PT_PRIVACY_POLICY_VERSION=2026-01
PT_CONSULTATION_RETENTION_DAYS=180
PT_PUBLIC_RATE_LIMIT=5
PT_PUBLIC_RATE_WINDOW_SECONDS=3600
PT_ALLOW_UNRATED_PUBLIC_CONSULTATIONS=false
# 운영 환경에서는 기본 salt를 바꾸고 Vercel Secret으로 관리하세요.
PT_RATE_LIMIT_SALT=

# 기존 회원 세션 영상 API를 사용할 때만 필요한 서버 전용 값입니다.
NOTION_VIDEO_MAP_JSON=
NOTION_SESSION_CONTENT_B64=
